# Development environment — auto-loaded by `next dev` (NODE_ENV=development).
# Points at the shared dev backend server on the LAN.
# To use your own local backend instead, override NEXT_PUBLIC_API_URL in .env.local.
NEXT_PUBLIC_API_URL=http://192.168.0.150:6001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google sign-in client ID (Web OAuth client; public, baked into the browser bundle)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1052209009496-928jtcb3nme4jqrupgv159mq3g7gvte8.apps.googleusercontent.com
