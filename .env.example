# Base URL of the backend REST API (NestJS). Includes the /api/v1 prefix.
# See docs/srs/00-overview.md §7 — base path /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public base URL of this storefront (used for canonical URLs / SEO metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key for the Get Help form CAPTCHA (FR-LEAD-006). Optional —
# leave blank in dev to skip the widget (the form still submits; the backend bypasses
# verification when its captcha is disabled). Use Cloudflare's test key in dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Seller details printed on the invoice (ORD FR-ORD-073). Optional — sensible
# defaults apply. BIN stays the placeholder until the real seller BIN is provided.
NEXT_PUBLIC_SELLER_NAME=SportsVault
NEXT_PUBLIC_SELLER_ADDRESS=Level 4, Bashundhara City, Panthapath, Dhaka 1215, Bangladesh
NEXT_PUBLIC_SELLER_PHONE=+880 1700-000000
NEXT_PUBLIC_SELLER_EMAIL=billing@sportsvault.com.bd
NEXT_PUBLIC_SELLER_BIN=000000000-0000
